.env
.venv/
venv/
env/

__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

*.log
# The unit appends its stdout here (StandardOutput=append:), and a snapshot taken
# while replacing it carries a date suffix that *.log does not match.
jev_server.log.stale-*
*.pid
# Decision and feedback logs carry answer previews and verdicts; they stay local.
jev_decisions.jsonl
jev_feedback.jsonl
# Quarantine and backups written by scripts/quarantine_queries.py
jev_decisions.jsonl.quarantine
jev_feedback.jsonl.quarantine
jev_decisions.jsonl.bak-*
jev_feedback.jsonl.bak-*
# Benchmark outputs embed raw queries; keep them local like the decision log.
laya_benchmark.jsonl
decision_benchmark.jsonl

storage/*.db
storage/*.db-*
storage/*.sqlite*
storage/*.npz

.DS_Store
*.swp
*.tmp
