# jev-router API
JEV_LLM_HOST=http://192.168.11.87:11434
JEV_LLM_MODEL=ornith-1.5-9b-256k
JEV_LIGHTRAG_API=http://127.0.0.1:8020
JEV_LIGHTRAG_CHUNKS_PATH=/path/to/LightRag/index/kv_store_text_chunks.json

# Local indexes
JEV_FTS5_DB_PATH=storage/jev_fts5.db
JEV_VECTOR_DB_PATH=storage/jev_vectors.npz
JEV_DECISION_LOG_PATH=jev_decisions.jsonl

# Working memory: a directory of Markdown documents indexed into the same FTS5
# table as the corpus, tagged entity_type='memory'.  The server re-indexes it on
# every start (api/server.py::_index_memory_docs), so editing a file is enough -
# restart the service, or run scripts/index_memory.py to index without one.
# A missing directory is not an error; the router starts either way.
JEV_MEMORY_DIR=/home/dry/memory

# Embeddings / vector tier
JEV_EMBEDDING_API=http://192.168.11.87:11434/api/embed
JEV_EMBEDDING_MODEL=mxbai-embed-large
# Total budget for the embedding call, enforced with asyncio.timeout (an httpx timeout is
# per socket read, not a deadline). The embedder lives on the node that powers itself off
# when idle, and it is the fall-through path's only remaining GPU dependency: healthy cost
# is ~32 ms, but a 30 s client timeout let a sleeping node stall a request for ~16 s. On
# expiry the vector layer is skipped and the local FTS5 results are served.
JEV_VECTOR_TIMEOUT_S=2.0
JEV_SIMILARITY_THRESHOLD=0.80

# How deep retrieval goes before assembly sees anything. 10 was measured to be too
# shallow: on "затяжка болтов головки блока цилиндров момент" the chunk holding the
# complete tightening sequence sits at rank 13, so at 10 it was never in the running and
# the agent kept reporting an incomplete context.
JEV_RETRIEVAL_LIMIT=20

# Characters of retrieved text handed to the agent, after duplicate chunks are dropped.
# A budget instead of the old fixed `[:3]`, which delivered 1691-3078 characters on four
# real queries while spending part of them on byte-identical copies of the same page.
# 16000 is the measured saturation point with a 20-result pool: at that value every query
# delivers its entire unique pool, and 20000 is byte-identical to it. At 12000 three of the
# four queries still drop chunks. Lower it to spend less on prefill, raise it only if
# chunks are still being dropped.
JEV_MAX_CONTEXT_CHARS=16000

# How much of the assembled context reaches the model. This was four unrelated hard-coded
# values - 4000 in the general agent, 3000 in code/db/troubleshooter - and the smallest one
# silently won, which made every other setting above inert. It defaults to
# JEV_MAX_CONTEXT_CHARS so the two cannot disagree.
# JEV_LLM_CONTEXT_CHARS=16000

# Timeouts
JEV_LIGHTRAG_CONNECT_TIMEOUT_S=1
JEV_LIGHTRAG_READ_TIMEOUT_S=5
# The graph tier is parked on this hardware (README, "Deferred"): retrieval alone
# measured 10.9 s against the 5 s read timeout above, so every fall-through request
# pays a guaranteed timeout for nothing. Set to 0 to skip the call and serve the same
# local retrieval instantly (fallback_reason becomes lightrag_disabled).
# 1 = call it (default, current behaviour), 0 = parked.
JEV_LIGHTRAG_ENABLED=1
JEV_LLM_CONNECT_TIMEOUT_S=2
JEV_LLM_READ_TIMEOUT_S=60

# Remote Laya System-1 classifier (GPU2). Advisory only: it never gains authority
# over retrieval, over command execution, or over the subject domain. It is started
# concurrently with the local index lookup and awaited only when the local path
# cannot answer, so locally answerable queries never pay for it (measured 55.98 ms
# -> 0.16 ms) and JEV_LAYA_TIMEOUT_S bounds what it can add to a fall-through.
#
# Measured from the Pi against GPU2 (2026-09-22, see docs/laya-preset-vs-custom-*.txt):
#   multilingual checkpoint  p50 28.6 ms, p95 30.4 ms
#   english checkpoint       p50 56.9 ms, p95 62.2 ms   <- 0.05 would always time out
# 0.15 s therefore fits the multilingual checkpoint with headroom while still
# capping what a hung GPU2 can cost. Raise it only with fresh measurements.
JEV_LAYA_URL=http://192.168.11.87:8031
JEV_LAYA_TIMEOUT_S=0.15
# Gates the shipped preset `task` signal only. The service's other confidence is
# the minimum over two questions we wrote ourselves and the checkpoint was never
# trained on; those produced confidently wrong answers (raspberry_pi at 0.9995 for
# "rewrite the router in Go"), and no threshold filters a confident mistake.
JEV_LAYA_CONFIDENCE_THRESHOLD=0.90
LAYA_MODEL=convaiinnovations/laya

# Optional llama.cpp-style decision endpoint
JEV_DECISION_ENGINE_URL=http://127.0.0.1:8080
JEV_DECISION_ENGINE_TIMEOUT_S=0.3
JEV_DECISION_ENGINE_LOW_CONFIDENCE=0.80

# Shadow mode: probe a candidate engine on live traffic WITHOUT letting it steer
# routing. Results land in JEV_DECISION_LOG_PATH as {"event": "shadow", ...} and in
# the /stats + /metrics counters. "off" (default) probes nothing.
#   JEV_SHADOW_MODE=off | laya | decision
JEV_SHADOW_MODE=off
# Defaults: laya -> JEV_LAYA_URL, decision -> JEV_DECISION_ENGINE_URL
# JEV_SHADOW_URL=http://192.168.11.87:8031
JEV_SHADOW_TIMEOUT_S=1.0
# Probes are diagnostic-only: at most this many run at once, the rest are skipped
# (counted as jev_shadow_skipped_total{reason="busy"}) so bursts cannot pile up.
JEV_SHADOW_MAX_INFLIGHT=1
JEV_SHADOW_SAMPLE_RATE=1.0

# Privacy: keep false for publication/production logs unless raw prompts are required.
JEV_LOG_RAW_QUERY=false

# ── Ground truth ──────────────────────────────────────────────────────
# Verdicts on answers, keyed by the decision_id returned in every /query response. Kept in
# a separate append-only file because a verdict arrives after the fact; merging it into the
# decision record would raise "which line wins?" for the same id.
JEV_FEEDBACK_LOG_PATH=jev_feedback.jsonl

# Write a bounded answer/context preview into each decision record. Without it a decision
# can only be labelled while the answer is still in hand, i.e. never, so the log cannot
# become a dataset at all. On by default: the corpus is a public car manual. Set false to
# log signals without content - the lengths stay, they are signals about the answer, not
# the answer itself.
JEV_LOG_ANSWER_PREVIEW=true
JEV_PREVIEW_CHARS=400

