# jev-router API
JEV_LLM_HOST=http://192.168.11.87:11434
JEV_LLM_MODEL=ornith-1.5-9b-256k
JEV_LIGHTRAG_API=http://127.0.0.1:8020
JEV_LIGHTRAG_CHUNKS_PATH=/path/to/LightRag/index/kv_store_text_chunks.json

# Local indexes
JEV_FTS5_DB_PATH=storage/jev_fts5.db
JEV_VECTOR_DB_PATH=storage/jev_vectors.npz
JEV_DECISION_LOG_PATH=jev_decisions.jsonl

# Working memory: a directory of Markdown documents indexed into the same FTS5
# table as the corpus, tagged entity_type='memory'.  The server re-indexes it on
# every start (api/server.py::_index_memory_docs), so editing a file is enough -
# restart the service, or run scripts/index_memory.py to index without one.
# A missing directory is not an error; the router starts either way.
# Their vectors are a separate, explicit step (scripts/build_memory_vectors.py):
# embedding needs GPU2, and a start must not depend on the GPU box being awake.
JEV_MEMORY_DIR=/home/dry/memory

# Imported chat corpus: Markdown written by scripts/import_chat_export.py from a
# Google Takeout Gemini export, indexed on every start exactly like the memory
# directory (api/server.py::_index_feeds, feed "chats", ids `gem:`).  Separate
# from JEV_MEMORY_DIR because the two have different owners and different chunk-id
# namespaces (`gem:` vs `mem:`): one being empty must not affect the other.
#
# Why it exists: a question discussed in Gemini was answered with the nearest
# unrelated neighbour (an OLX listing, cosine 0.47), because the whole Gemini
# part of the corpus was ONE chat - the single file that happened to be in
# ~/Downloads when the old converter last ran.  The export held 351
# conversations; 2969 activity items, of which 2751 carry an answer.
#
#   python3 scripts/import_chat_export.py --list
#   python3 scripts/import_chat_export.py --match x728,geekworm
#   python3 scripts/index_feeds.py --feed chats        # or just restart the service
#   python3 scripts/build_memory_vectors.py --namespace chats
JEV_CORPUS_DIR=/home/dry/LightRag/feeds/chats

# Collected project material: documentation and commit history of the repositories
# on this machine, written by `jev-collect` (Go, /home/dry/jev-collect) and indexed
# on start as feed "projects" with ids `prj:`.  A collector writes Markdown and a
# manifest and nothing else, because the FTS5 table is derived - rows written by
# hand do not survive a restart - and because the invariant "a row reaches both
# FTS5 and the vector archive" must keep exactly one implementation.
#
#   go run ./cmd/jev-collect --feed projects --out $JEV_PROJECTS_DIR \
#     --repo Jev=/home/dry/Jev --repo jev-mcp=/home/dry/jev-mcp ...
#   python3 scripts/index_feeds.py --feed projects
#   python3 scripts/build_memory_vectors.py --namespace projects
#
# What it takes: README, docs/**, ADRs, CHANGELOG, CONTRIBUTING and the commit
# history as a "decisions" document.  Not source code: the agent reads code itself,
# and a corpus full of it would bury the documents that say why.
JEV_PROJECTS_DIR=/home/dry/LightRag/feeds/projects

# Embeddings / vector tier
#
# The embedder runs on its OWN CPU-only ollama instance (:11435), not on the GPU one.
# The GPU instance drops bge-m3 whenever a fresh large model is loaded - measured with
# 7228 MiB of the card free, so it is the fitter's decision, not memory pressure - and
# keep_alive=24h does not hold a model through it.  Reloading cost 4656 ms against a
# 5.5 s budget: paid, and nearly lost.  Off the card there is nothing to evict.
#
# Same binary and same model files, CUDA hidden via CUDA_VISIBLE_DEVICES="" on the
# process, so the embedding geometry is unchanged (cos 0.999992-0.999994 against the GPU
# instance; the 4e-4 spread is fp32 summation order) and the index needs no rebuild -
# verified on the golden numbers: 0.5684 / 0.6032 / 0.6721 / 0.5574 all reproduced.
#
# Do not point this at the CPU instance without the start-up warm-up: a fresh CPU runner
# pays multi-second costs on its first calls (measured 4 of 16 up to 6584 ms) and is
# stable at 43-116 ms afterwards.  _warm_embedder sends four varied lengths for exactly
# that reason.  Measured with the warm-up: 12 queries before and after loading the large
# model - p50 119.2 vs 118.7 ms, none above 1 s.
JEV_EMBEDDING_API=http://192.168.11.87:11435/api/embed
# bge-m3 (1024d, multilingual, 8192 ctx).  The previous embedder,
# mxbai-embed-large, declares `language: [en]` and this corpus is
# Russian: correct answers scored 0.55-0.59 while unrelated queries
# reached 0.87, so no threshold could separate them.
JEV_EMBEDDING_MODEL=bge-m3
# The embedder and the answer model share one 12 GB card, and ollama unloads
# a model that is not kept.  Without this, every embedding call reloads
# bge-m3 (4163 ms measured) once the answer model is resident, the 2 s
# vector budget is blown, and the vector tier drops out of every request
# silently while the service keeps answering from the degraded path.
# 24h, not -1: it has to survive a working day, because the cost is paid by the
# first request after idle (measured there: 4.2 s cold against the 2.0 s budget,
# so the vector tier was skipped and the query fell to local rows).  A -1 would
# pin it forever and hold VRAM the 10 GB model needs when GPU2 is switched to
# that workload.
JEV_EMBEDDING_KEEP_ALIVE=24h

# Timeout for loading the embedder at start-up, off the request path.  Generous on
# purpose: this call is allowed to take as long as a model load takes (measured
# 2219 ms), which is exactly what the 2 s request budget cannot cover - so the
# first query after a restart is warm instead of falling to the local rows.
JEV_EMBEDDING_WARMUP_TIMEOUT_S=30

# Confidence reported by the fts_fallback status: local rows were found but none
# matched decisively (the exact-FTS gate declined the early exit).  Kept at the
# floor of its band so no relevance is claimed; exact_fts carries 0.95 for a
# decisive hit, and a caller must be able to tell the two apart.
JEV_FTS_FALLBACK_CONFIDENCE=0.5

# The vector index holds the golden corpus only: the memory documents and the
# structured Gemini chats.  Any source path containing one of these markers is
# excluded from it by both builders (build_vector_index.py filters before
# embedding, build_memory_vectors.py prunes an existing archive).  The OCR'd
# Espero manual stays in FTS5, where literal term matching is unaffected.
# Comma-separated substrings.
JEV_VECTOR_EXCLUDE_SOURCES=d_espero.pdf

# Priority for the memory documents in the BM25 ordering: the factor
# multiplies bm25() for entity_type='memory' rows only.  bm25 is
# negative and lower is better, so >1 promotes.  1 disables it.
JEV_FTS_MEMORY_BOOST=1.5
# The exact-FTS early exit may not be taken by the raw OCR corpus
# (JEV_VECTOR_EXCLUDE_SOURCES) on its own while memory rows exist; a held-back
# raw row still rides into the context behind the vector hits.
JEV_FTS_GATE_REQUIRE_GOLDEN=1
# Content terms (function words do not count) a candidate must contain to take
# that exit.  Two out of six is a coincidence of ordinary words: questions about
# user services exited on "при" + "загрузке".
JEV_FTS_GATE_MIN_TERMS=3
# ...and a raw-corpus chunk needs this many to keep the exit for itself, which is
# how the manual's own questions stay local.  Genuine matches reach 5-6 of 6;
# coincidences reach 2.
JEV_FTS_GATE_RAW_EXIT_TERMS=4
# Total budget for the embedding call, enforced with asyncio.timeout (an httpx timeout is
# per socket read, not a deadline). The embedder lives on the node that powers itself off
# when idle, and it is the fall-through path's only remaining GPU dependency. Healthy cost
# is 47-104 ms - and that holds even when ollama has placed the model on the CPU (measured:
# 0.08 GB in VRAM of 1.26, still 67-104 ms per call), so processor placement is cheap here
# and is NOT the reason this budget matters.
#
# What matters is the LOAD.  Measured 24.09.2026 on the same endpoint: an unloaded model
# costs 2124 ms for the first call and 47 ms for the next one.  The previous value of 2.0 s
# therefore sat 100 ms BELOW the price of the event it was waiting for, and the consequence
# was not a slow request but a discarded one: the wait was paid in full, ollama finished
# loading in the background anyway, and the answer was thrown away - so the 2 s bought
# nothing for that request, only for the next.  In the log that appeared as a weak local
# pool with degraded=false, indistinguishable from a healthy corpus that matched nothing.
#
# 5.5 s covers BOTH measured load costs, which is why it is not 3.5 s: an uncontended
# reload costs 2124 ms, but a reload with the answer model already resident measured
# 4656 ms - ollama drops bge-m3 when a fresh large model is loaded (see below), and the
# reload then runs against ~1.2 GB of free card instead of 7 GB, so it takes twice as long.
# 3.5 s covered the first case and still discarded the second.  Margin: ~850 ms.
#
# What it does NOT fix, and the reason a CPU instance is the real answer: the eviction
# itself.  Measured, keep_alive does not hold a model at all - a fresh load of the 9B model
# removed bge-m3 from the card while 7228 MiB was still free, so this is the fitter's
# decision, not memory pressure.  Raising the budget only pays for the reload; keeping the
# embedder out of VRAM removes the reload.
#
# Kept equal to JEV_VECTOR_TIMEOUT_S in .env on purpose: tests do not load .env, and a
# default that disagrees with production is how a budget regression stays invisible.
JEV_VECTOR_TIMEOUT_S=5.5
# Vector hit threshold, calibrated for bge-m3 (the previous 0.80 belonged to
# mxbai's more generous cosine scale and made the tier return nothing).
# Measured 23.09.2026 on the golden corpus: correct targets 0.5684-0.6721 at rank
# #1, genuinely unrelated queries 0.3773-0.3789.  0.45 sits in that gap.
#
# It is now the *first* of two conditions.  The corpus grew from 209 rows to 5269
# chunks, the noise floor rose with it, and measured 26.09.2026 three of six
# questions the corpus cannot answer at all were coming back labelled decisive - a
# cat, a currency rate, a tax letter - with over a thousand characters of selected
# text as the evidence.  So a hit must also stand JEV_DECISIVE_MARGIN above this
# query's own chance level against the corpus (the 95th percentile of its
# similarity to every chunk), which is a property of the corpus rather than of a
# number: measured, the margin alone calls a question about a train ticket
# decisive, and the floor alone is what failed in the first place.
#
# Calibrated on 13 fixed questions (7 answerable, 6 not) by
# scripts/measure_decisive_criterion.py: 7/7 decisive, 6/6 refused, with 0.0148 of
# slack on the positive side and 0.0044 on the negative.  Those numbers are thin
# and must be re-measured whenever the corpus grows by an order of magnitude -
# which the chat import will do.  The script must be run with a *new* question set
# each time: this one is already partly spent, because the measured queries were
# quoted back into the corpus (in commit messages, which are immutable, and in
# notes), and then the literal tier answers them by itself.
JEV_SIMILARITY_THRESHOLD=0.45
JEV_DECISIVE_MARGIN=0.10
JEV_DECISIVE_FLOOR_QUANTILE=0.95
# Below this many chunks the quantile is one of the hits, so "standing out from
# the corpus" is not measurable and the absolute threshold is the whole rule.
# Keeps a fresh install and the test fixtures behaving as they did before.
JEV_DECISIVE_MIN_CORPUS=128

# ── Fast path: when the local tiers already hold the answer ───────────────
#
# Both bars gate the decision to answer without tier 4 at all.  The condition is the
# material, not a threshold for its own sake: tier 2 returns the answer text, so a decisive
# result that still goes through a 9B model costs seconds and can only lose information.
#
# Measured on the acceptance question ("Как у нас настраиваются пользовательские systemd
# сервисы?"): exact_fts 0.95, 1209 characters of on-point context, 166 ms - against
# **12617 ms** through the model on the same request, which returned its reasoning about the
# question ("The question is in Russian... Let me base my answer on the provided context.")
# rather than the answer to it.  After the change: 15-45 ms, median 17.5 ms.
#
# Semantic bar.  NOT 0.90: bge-m3 compresses related pairs on this corpus to 0.55-0.67, and
# the measured decisive hits are 0.5574-0.6721 - a 0.90 bar would never fire in production
# while passing every unit test, because a unit test sets the confidence it wants.  The
# default is JEV_SIMILARITY_THRESHOLD, i.e. the bar the tier itself uses to call a hit
# decisive, so the two cannot disagree; the entry below documents that it can be overridden.
# tests/test_fast_path.py fails if this is ever set above the weakest measured decisive hit.
JEV_FAST_PATH_VECTOR_MIN=0.45
# Literal-match bar.  A formality today - the FTS gate reports a fixed 0.95 when it accepts -
# but it keeps the decision explicit rather than implicit, so a future real confidence has a
# tested place to land instead of an accidental always-yes.
JEV_FAST_PATH_FTS_MIN=0.90

# Reasoning on or off for the local model (ollama `think`).  Default off.
#
# ornith-1.5-9b-256k reasons *into the answer field*: ollama returns no separate `thinking`
# key for it, so the reasoning cannot be filtered afterwards - it arrives as the answer.
# Measured: `response` was 1918 characters beginning "The user is asking about how
# user-level systemd services are configured. Let me analyze the context provided."  With
# `think: false` the same prompt returned a Russian answer in 1434 characters.
#
# Do NOT pair this with a smaller num_predict: measured at 512, eval_count came back exactly
# 512, i.e. the ANSWER was truncated mid-sentence.  With thinking off, the token cap bounds
# the answer rather than the reasoning.
JEV_LLM_THINK=0

# How deep retrieval goes before assembly sees anything. 10 was measured to be too
# shallow: on "затяжка болтов головки блока цилиндров момент" the chunk holding the
# complete tightening sequence sits at rank 13, so at 10 it was never in the running and
# the agent kept reporting an incomplete context.
JEV_RETRIEVAL_LIMIT=20

# Characters of retrieved text handed to the agent, after duplicate chunks are dropped.
# A budget instead of the old fixed `[:3]`, which delivered 1691-3078 characters on four
# real queries while spending part of them on byte-identical copies of the same page.
# 16000 is the measured saturation point with a 20-result pool: at that value every query
# delivers its entire unique pool, and 20000 is byte-identical to it. At 12000 three of the
# four queries still drop chunks. Lower it to spend less on prefill, raise it only if
# chunks are still being dropped.
JEV_MAX_CONTEXT_CHARS=16000

# How much of the assembled context reaches the model. This was four unrelated hard-coded
# values - 4000 in the general agent, 3000 in code/db/troubleshooter - and the smallest one
# silently won, which made every other setting above inert. It defaults to
# JEV_MAX_CONTEXT_CHARS so the two cannot disagree.
# JEV_LLM_CONTEXT_CHARS=16000

# Timeouts
JEV_LIGHTRAG_CONNECT_TIMEOUT_S=1
JEV_LIGHTRAG_READ_TIMEOUT_S=5
# The graph tier is parked on this hardware (README, "Deferred"): retrieval alone
# measured 10.9 s against the 5 s read timeout above, so every fall-through request
# pays a guaranteed timeout for nothing. Set to 0 to skip the call and serve the same
# local retrieval instantly (fallback_reason becomes lightrag_disabled).
# 1 = call it (default, current behaviour), 0 = parked.
JEV_LIGHTRAG_ENABLED=1
JEV_LLM_CONNECT_TIMEOUT_S=2
JEV_LLM_READ_TIMEOUT_S=60

# Remote Laya System-1 classifier (GPU2). Advisory only: it never gains authority
# over retrieval, over command execution, or over the subject domain. It is started
# concurrently with the local index lookup and awaited only when the local path
# cannot answer, so locally answerable queries never pay for it (measured 55.98 ms
# -> 0.16 ms) and JEV_LAYA_TIMEOUT_S bounds what it can add to a fall-through.
#
# Measured from the Pi against GPU2 (2026-09-22, see docs/laya-preset-vs-custom-*.txt):
#   multilingual checkpoint  p50 28.6 ms, p95 30.4 ms
#   english checkpoint       p50 56.9 ms, p95 62.2 ms   <- 0.05 would always time out
# 0.15 s therefore fits the multilingual checkpoint with headroom while still
# capping what a hung GPU2 can cost. Raise it only with fresh measurements.
JEV_LAYA_URL=http://192.168.11.87:8031
JEV_LAYA_TIMEOUT_S=0.15
# Gates the shipped preset `task` signal only. The service's other confidence is
# the minimum over two questions we wrote ourselves and the checkpoint was never
# trained on; those produced confidently wrong answers (raspberry_pi at 0.9995 for
# "rewrite the router in Go"), and no threshold filters a confident mistake.
JEV_LAYA_CONFIDENCE_THRESHOLD=0.90
LAYA_MODEL=convaiinnovations/laya

# Optional llama.cpp-style decision endpoint
JEV_DECISION_ENGINE_URL=http://127.0.0.1:8080
JEV_DECISION_ENGINE_TIMEOUT_S=0.3
JEV_DECISION_ENGINE_LOW_CONFIDENCE=0.80

# Shadow mode: probe a candidate engine on live traffic WITHOUT letting it steer
# routing. Results land in JEV_DECISION_LOG_PATH as {"event": "shadow", ...} and in
# the /stats + /metrics counters. "off" (default) probes nothing.
#   JEV_SHADOW_MODE=off | laya | decision
JEV_SHADOW_MODE=off
# Defaults: laya -> JEV_LAYA_URL, decision -> JEV_DECISION_ENGINE_URL
# JEV_SHADOW_URL=http://192.168.11.87:8031
JEV_SHADOW_TIMEOUT_S=1.0
# Probes are diagnostic-only: at most this many run at once, the rest are skipped
# (counted as jev_shadow_skipped_total{reason="busy"}) so bursts cannot pile up.
JEV_SHADOW_MAX_INFLIGHT=1
JEV_SHADOW_SAMPLE_RATE=1.0

# Privacy: keep false for publication/production logs unless raw prompts are required.
JEV_LOG_RAW_QUERY=false

# ── Ground truth ──────────────────────────────────────────────────────
# Verdicts on answers, keyed by the decision_id returned in every /query response. Kept in
# a separate append-only file because a verdict arrives after the fact; merging it into the
# decision record would raise "which line wins?" for the same id.
JEV_FEEDBACK_LOG_PATH=jev_feedback.jsonl

# Write a bounded answer/context preview into each decision record. Without it a decision
# can only be labelled while the answer is still in hand, i.e. never, so the log cannot
# become a dataset at all. On by default: the corpus is a public car manual. Set false to
# log signals without content - the lengths stay, they are signals about the answer, not
# the answer itself.
JEV_LOG_ANSWER_PREVIEW=true
JEV_PREVIEW_CHARS=400

